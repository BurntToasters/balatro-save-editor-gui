# Copy to .env and fill in. Loaded by release scripts via `dotenv -e .env --`.

# GitHub releases use the GitHub CLI credential store. Run `gh auth login` on
# each release machine; no GitHub token belongs in this file.

# --- Windows Authenticode signing via Azure Artifact Signing (Public Trust) ---
# Once per Windows release VM (as Administrator), run: npm run setup:win:artifact-signing
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Required for every Windows signature check: exact signing cert Subject DN
# (must match Azure Artifact Signing profile Subject name). Example:
#   AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=CN=Your Name, O=Your Org, C=US
# Tip after a signed build:
#   (Get-AuthenticodeSignature .\dist\balatro-save-editor\balatro-save-editor.exe).SignerCertificate.Subject
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
# Stable versions (x.y.z) refuse SKIP_WIN_CODESIGN=1.
SKIP_WIN_CODESIGN=0
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

# --- GPG signing (sign:gpg) ---
GPG_KEY_ID=
GPG_PASSPHRASE=

# --- macOS code signing (sign:mac) ---
# Developer ID Application identity as shown by: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# --- macOS keychain (SSH release only) ---
# Needed when releasing over SSH: npm run release:mac:ssh
# The login keychain is locked in SSH sessions; this unlocks it for codesign.
KEYCHAIN_PASSWORD=

# --- macOS notarization (notarize:mac) ---
# Option A: a stored notarytool keychain profile (recommended)
#   xcrun notarytool store-credentials --apple-id ... --team-id ... --password ...
APPLE_KEYCHAIN_PROFILE=
# Option B: Apple ID + app-specific password (used if no keychain profile)
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_PASSWORD=

# --- optional GitHub request tuning ---
# GH_REQUEST_RETRIES=3
# GH_REQUEST_RETRY_DELAY_MS=1500
